# Секреты и настройки docker-стека BIOTORF Business OS.
# Скопируйте в .env (cp .env.example .env) и заполните реальными значениями.
# compose подхватывает этот файл автоматически.

# ── Вебхуки коммуникаций (обязательно замените на длинные случайные строки!) ──
TELEGRAM_WEBHOOK_SECRET=dev-telegram-secret
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
TELEPHONY_TOKEN=dev-telephony-token

# ── Telegram long-poll воркер (профиль "tg") ──
TELEGRAM_BOT_TOKEN=

# ── CORS для бэкенда (через запятую) ──
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,null

# ── URL API для сборки фронтенда ──
# Оставьте пустым: во docker-стеке фронт сам определит бэкенд по текущему хосту
# (nginx проксирует /api, /webhooks, /health). Задайте явно, только если API живёт
# на другом домене, например: https://api.example.com
VITE_COMMS_API=

# ── Реестр клиентов для автопривязки звонков по номеру ──
# По умолчанию используется backend/farms.example.json (уже в git).
# Свой рабочий файл: cp backend/farms.example.json backend/farms.json
# и раскомментируйте строку ниже (или передайте переменную при запуске):
# FARMS_HOST_FILE=./backend/farms.json
